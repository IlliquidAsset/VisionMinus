{
  "contract_name": "powerdolphin_runtime_parity",
  "version": "2026-03-30",
  "artifacts": {
    "matrix_markdown": ".sisyphus/contracts/runtime_parity_matrix.md",
    "spot_lock_defaults_markdown": ".sisyphus/contracts/spot_lock_defaults.md"
  },
  "selectors": {
    "gps_raw_present": {
      "description": "True when lat/lon telemetry is fresh and non-zero.",
      "policy": "fresh_nonzero_position"
    },
    "gps_autonomy_ready": {
      "description": "True only when GPS quality is autonomy-safe.",
      "rule": "eph <= 300 && gpsLevel > 8",
      "source": "fresh_approach/smali_classes3/com/powervision/gcs/ui/aty/ship/ShipMainActivity.smali:4212-4236"
    },
    "gps_degraded_reason": {
      "enum": [
        "missing_eph",
        "low_sats",
        "bad_hdop",
        "stale",
        "no_position"
      ]
    },
    "manual_control_ready": {
      "description": "Manual control gate independent from GPS quality.",
      "rule": "link_healthy && unlock_confirmed && manual_mode_compatible"
    },
    "calibration_phase": {
      "enum": [
        "idle",
        "start_pending",
        "started",
        "orienting",
        "progressing",
        "success",
        "failed",
        "timeout",
        "cancelled"
      ]
    },
    "command_intent_state": {
      "enum": [
        "idle",
        "sent",
        "acked",
        "confirmed",
        "timeout",
        "stale",
        "failed"
      ]
    }
  },
  "thresholds": {
    "gps": {
      "eph_max": 300,
      "gps_level_min_exclusive": 8,
      "satellites_rule_note": "Legacy predicate uses gpsLevel > 8"
    },
    "rocker": {
      "fields": [
        "x",
        "r"
      ],
      "scale_by": "mRockerEffectivePercent",
      "clamp_min": -1000,
      "clamp_max": 1000,
      "center_zero_behavior": "when both inputs are zero, set x=0 and r=0",
      "output_call": "PVSDK_W4_API.controlRocker(rocker)",
      "source": "fresh_approach/smali_classes3/com/powervision/gcs/ui/aty/ship/ShipMainActivity.smali:13166-13535"
    }
  },
  "timeouts_ms": {
    "unlock_confirm": 3000,
    "telemetry_high_rate_ttl": 2000,
    "mode_arm_calibration_ttl": 5000,
    "mission_start": 8000,
    "calibration_start": 5000,
    "calibration_terminal": 90000
  },
  "hysteresis": {
    "gps_autonomy_ready": {
      "enter_continuous_ms": 3000,
      "exit_hard_failure": "immediate",
      "exit_soft_failure_consecutive_samples": 2,
      "reentry_cooldown_ms": 5000
    }
  },
  "flows": {
    "unlock": {
      "trigger": "SlideReturnView.returnSlide",
      "request_action": "PVSDK_W4_API.setArmStatus(1)",
      "request_source": "fresh_approach/smali_classes3/com/powervision/gcs/ui/aty/ship/ShipMainActivity$60.smali:53-76",
      "confirmation_mode": "callback_driven",
      "callback_listener_registration": "PVSDK_W4_API.setArmStatusListener(this)",
      "callback_listener_source": "fresh_approach/smali_classes3/com/powervision/gcs/ui/aty/ship/ShipMainActivity.smali:13829",
      "callback_success_method": "rayArm()",
      "callback_success_source": "fresh_approach/smali_classes3/com/powervision/gcs/ui/aty/ship/ShipMainActivity.smali:13604-13627",
      "callback_effect": "handler message + UI thread runnable + isShipArm=true"
    },
    "mission_start": {
      "timeout_ms": 8000,
      "gate": "requires gps_autonomy_ready == true",
      "policy": "blocked_when_degraded"
    },
    "calibration": {
      "mode": "callback_driven_fsm",
      "callback_methods": {
        "setMagCalibrationStatusStartSuccess": 1,
        "setMagCalibrationStatusCalibration": 2,
        "setMagCalibrationStatusOrientationDetected": 3,
        "setMagCalibrationStatusSideDone": 4,
        "setMagCalibrationStatusCalibrationSuccess": 5,
        "setMagCalibrationStatusCalibrationFailed": 6,
        "setMagCalibrationStatusCalibrationTimeout": 6,
        "setMagCalibrationStatusStartFailed": 7
      },
      "message_to_phase": {
        "1": "started",
        "2": "progressing",
        "3": "orienting",
        "4": "progressing",
        "5": "success",
        "6": "failed_or_timeout",
        "7": "start_failed"
      },
      "source": "fresh_approach/smali_classes2/com/powervision/aircraft/ui/activity/MagCalibrationStartActivity.smali:1013-1316"
    }
  },
  "conflict_rules": {
    "callback_order": {
      "timestamp_source": {
        "gps": "bridge_receive_time unless sdk_payload_timestamp exists",
        "arm_mode": "bridge_receive_time",
        "calibration": "bridge_receive_time",
        "mission": "sdk_payload_sequence else bridge_receive_time"
      },
      "drop_policy": "drop stale callbacks older than latest confirmed domain state",
      "overwrite_policy": "stale callbacks MUST NOT overwrite newer confirmed arm/mode/calibration state"
    }
  },
  "spot_lock_defaults": {
    "deadband_m": 3.0,
    "pulse_on_ms": 1000,
    "pulse_off_ms": 2000,
    "thrust_min_percent": 4,
    "thrust_max_percent": 12
  },
  "classification": {
    "parity_required": [
      "gps_autonomy_ready_thresholds",
      "gps_hysteresis_rules",
      "unlock_callback_confirmation_flow",
      "manual_control_ready_independent_of_gps",
      "rocker_x_r_scaling_and_clamp_-1000_1000",
      "mission_start_timeout_and_gate",
      "calibration_callback_fsm",
      "runtime_timeouts_and_ttls",
      "stale_callback_drop_policy"
    ],
    "modernization_only": [
      "spot_lock_auto_tuning_outside_default_envelope",
      "ui_copy_or_visual_refinement_after_callback_confirmation",
      "additional_diagnostics_without_state_semantic_change"
    ]
  }
}
